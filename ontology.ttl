<https://w3id.org/cterm#hasUse> rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/ci#cam
<https://w3id.org/ci#cam> rdf:type owl:DatatypeProperty ;
                          rdfs:domain <https://w3id.org/ci#Work> ;
                          rdfs:range xsd:boolean ;
                          rdfs:comment "Indicates whether a Work is associated with the Minimum Environmental Criteria (Criteri Ambientali Minimi, CAM) defined by the Italian Ministry of Environment."@en ;
                          rdfs:comment "Indica se un Work è associato ai Criteri Ambientali Minimi (CAM) definiti dal Ministero italiano dell'Ambiente."@it ;
                          rdfs:label "environmental and ecological requirements defined by the Italian Ministry of Environment" .


###  https://w3id.org/ci#code
<https://w3id.org/ci#code> rdf:type owl:DatatypeProperty ;
                           rdfs:domain [ rdf:type owl:Class ;
                                         owl:unionOf ( <https://w3id.org/ci#Activity>
                                                       <https://w3id.org/ci#CostComponent>
                                                       <https://w3id.org/ci#CostItem>
                                                       <https://w3id.org/ci#Work>
                                                     )
                                       ] ;
                           rdfs:range xsd:string ;
                           rdfs:comment "Provides the alphanumeric identifier or classification code assigned to an Activity, CostComponent, CostItem, or Work."@en ;
                           rdfs:comment "Fornisce l'identificatore alfanumerico o il codice di classificazione assegnato a un'Activity, CostComponent, CostItem o Work."@it ;
                           rdfs:label "code" .


###  https://w3id.org/ci#descriptionDetail
<https://w3id.org/ci#descriptionDetail> rdf:type owl:DatatypeProperty ;
                                        rdfs:domain [ rdf:type owl:Class ;
                                                      owl:unionOf ( <https://w3id.org/ci#CostItem>
                                                                    <https://w3id.org/ci#CostComponent>
                                                                    <https://w3id.org/ci#Activity>
                                                                    <https://w3id.org/ci#Work>
                                                                  )
                                                    ] ;
                                        rdfs:range xsd:string ;
                                        rdfs:comment "Provides a detailed textual description that complements the general description of the represented entity."@en ;
                                        rdfs:comment "Fornisce una descrizione testuale di dettaglio che integra la descrizione generale dell'entità rappresentata."@it ;
                                        rdfs:label "descriptionDetail" .


###  https://w3id.org/ci#descriptionGeneral
<https://w3id.org/ci#descriptionGeneral> rdf:type owl:DatatypeProperty ;
                                         rdfs:domain [ rdf:type owl:Class ;
                                                       owl:unionOf ( <https://w3id.org/ci#CostItem>
                                                                     <https://w3id.org/ci#CostComponent>
                                                                     <https://w3id.org/ci#Activity>
                                                                     <https://w3id.org/ci#Work>
                                                                   )
                                                     ] ;
                                         rdfs:range xsd:string ;
                                         rdfs:comment "Provides the general textual description used to identify and describe the represented entity in a standardized form."@en ;
                                         rdfs:comment "Fornisce la descrizione testuale generale utilizzata per identificare e descrivere l'entità rappresentata in forma standardizzata."@it ;
                                         rdfs:label "descriptionGeneral" .


###  https://w3id.org/ci#excluded
<https://w3id.org/ci#excluded> rdf:type owl:DatatypeProperty ;
                               rdfs:domain [ rdf:type owl:Class ;
                                             owl:unionOf ( <https://w3id.org/ci#Activity>
                                                           <https://w3id.org/ci#Work>
                                                         )
                                           ] ;
                               rdfs:range xsd:string ;
                               rdfs:comment "Specifies, in textual form, items, operations, conditions, or provisions that are explicitly excluded from the scope of an Activity or Work."@en ;
                               rdfs:comment "Specifica, in forma testuale, voci, operazioni, condizioni o prescrizioni esplicitamente escluse dall'ambito di un'Activity o di un Work."@it ;
                               rdfs:label "excluded" .


###  https://w3id.org/ci#included
<https://w3id.org/ci#included> rdf:type owl:DatatypeProperty ;
                               rdfs:domain [ rdf:type owl:Class ;
                                             owl:unionOf ( <https://w3id.org/ci#Activity>
                                                           <https://w3id.org/ci#Work>
                                                         )
                                           ] ;
                               rdfs:range xsd:string ;
                               rdfs:comment "Specifies, in textual form, items, operations, conditions, or provisions that are explicitly included within the scope of an Activity or Work."@en ;
                               rdfs:comment "Specifica, in forma testuale, voci, operazioni, condizioni o prescrizioni esplicitamente incluse nell'ambito di un'Activity o di un Work."@it ;
                               rdfs:label "included" .


###  https://w3id.org/ci#keywords
<https://w3id.org/ci#keywords> rdf:type owl:DatatypeProperty ;
                               rdfs:domain [ rdf:type owl:Class ;
                                             owl:unionOf ( <https://w3id.org/ci#Activity>
                                                           <https://w3id.org/ci#Work>
                                                         )
                                           ] ;
                               rdfs:range xsd:string ;
                               rdfs:comment "Provides keywords used to support the identification, indexing, retrieval, or interpretation of an Activity or Work."@en ;
                               rdfs:comment "Fornisce parole chiave utilizzate per supportare l'identificazione, l'indicizzazione, il recupero o l'interpretazione di un'Activity o di un Work."@it ;
                               rdfs:label "keywords" .


###  https://w3id.org/ci#law
<https://w3id.org/ci#law> rdf:type owl:DatatypeProperty ;
                          rdfs:domain <https://w3id.org/ci#Work> ;
                          rdfs:range xsd:string ;
                          rdfs:comment "Provides a textual reference to legislation or regulatory requirements applicable to a Work."@en ;
                          rdfs:comment "Fornisce un riferimento testuale alla legislazione o ai requisiti normativi applicabili a un Work."@it ;
                          rdfs:label "law" .


###  https://w3id.org/ci#measurementRules
<https://w3id.org/ci#measurementRules> rdf:type owl:DatatypeProperty ;
                                       rdfs:domain <https://w3id.org/ci#CostComponent> ;
                                       rdfs:range xsd:string ;
                                       rdfs:comment "Specifies the rules or criteria to be applied when measuring or quantifying a CostComponent."@en ;
                                       rdfs:comment "Specifica le regole o i criteri da applicare nella misurazione o quantificazione di un CostComponent."@it ;
                                       rdfs:label "measurementRules" .


###  https://w3id.org/ci#prefix
<https://w3id.org/ci#prefix> rdf:type owl:DatatypeProperty ;
                             rdfs:domain <https://w3id.org/ci#CostItem> ;
                             rdfs:range xsd:string ;
                             rdfs:comment "Provides the prefix used as an identifying segment of the code assigned to a CostItem."@en ;
                             rdfs:comment "Fornisce il prefisso utilizzato come segmento identificativo del codice assegnato a un CostItem."@it ;
                             rdfs:label "prefisso"@it ,
                                        "prefix"@en .


###  https://w3id.org/ci#quantityUnitOfMeasure
<https://w3id.org/ci#quantityUnitOfMeasure> rdf:type owl:DatatypeProperty ;
                                            rdfs:domain [ rdf:type owl:Class ;
                                                          owl:unionOf ( <https://w3id.org/ci#CostItem>
                                                                        <https://w3id.org/ci#CostComponent>
                                                                        <https://w3id.org/ci#Activity>
                                                                        <https://w3id.org/ci#Work>
                                                                      )
                                                        ] ;
                                            rdfs:range xsd:decimal ;
                                            rdfs:comment "Specifies the numerical quantity associated with the reference unit of measure used to express the represented entity, for example 1 square metre or 100 units."@en ;
                                            rdfs:comment "Specifica la quantità numerica associata all'unità di misura di riferimento utilizzata per esprimere l'entità rappresentata, ad esempio 1 metro quadrato o 100 unità."@it ;
                                            rdfs:label "quantityUnitOfMeasure" .


###  https://w3id.org/ci#techSpecs
<https://w3id.org/ci#techSpecs> rdf:type owl:DatatypeProperty ;
                                rdfs:domain [ rdf:type owl:Class ;
                                              owl:unionOf ( <https://w3id.org/ci#Activity>
                                                            <https://w3id.org/ci#Work>
                                                          )
                                            ] ;
                                rdfs:range xsd:string ;
                                rdfs:comment "Provides technical specifications, requirements, or execution conditions associated with an Activity or Work."@en ;
                                rdfs:comment "Fornisce specifiche tecniche, requisiti o condizioni di esecuzione associati a un'Activity o a un Work."@it ;
                                rdfs:label "tech specs" .


###  https://w3id.org/ci#unitPrice
<https://w3id.org/ci#unitPrice> rdf:type owl:DatatypeProperty ;
                                rdfs:domain <https://w3id.org/ci#CostItem> ;
                                rdfs:range xsd:decimal ;
                                rdfs:comment "Specifies the monetary unit price assigned to a CostItem or ProductionResult for its reference unit of measure."@en ;
                                rdfs:comment "Specifica il prezzo unitario monetario assegnato a un CostItem o ProductionResult per la relativa unità di misura di riferimento."@it ;
                                rdfs:label "unit price" .


#################################################################
#    Classes
#################################################################

###  http://qudt.org/schema/qudt/Unit
<http://qudt.org/schema/qudt/Unit> rdf:type owl:Class .


###  https://schema.org/Person
<https://schema.org/Person> rdf:type owl:Class .


###  https://w3id.org/ci#Activity
<https://w3id.org/ci#Activity> rdf:type owl:Class ;
                               rdfs:subClassOf owl:Thing ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty <https://w3id.org/cterm#hasFunction> ;
                                                 owl:allValuesFrom <https://w3id.org/cterm#FunctionOfActivity>
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty <https://w3id.org/cterm#hasUse> ;
                                                 owl:allValuesFrom <https://w3id.org/cterm#UseOfActivity>
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty <https://w3id.org/cterm#hasCategory> ;
                                                 owl:allValuesFrom <https://w3id.org/cterm#CategoryOfActivity>
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty <https://w3id.org/cterm#hasFamily> ;
                                                 owl:allValuesFrom <https://w3id.org/cterm#FamilyOfActivity>
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty <https://w3id.org/cterm#hasObject> ;
                                                 owl:allValuesFrom <https://w3id.org/cterm#ObjectOfActivity>
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty <https://w3id.org/cterm#hasType> ;
                                                 owl:allValuesFrom <https://w3id.org/cterm#TypeOfActivity>
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty <https://w3id.org/ci#hasUnit> ;
                                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass <http://qudt.org/schema/qudt/Unit>
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty <https://w3id.org/ci#code> ;
                                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onDataRange xsd:string
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty <https://w3id.org/ci#descriptionGeneral> ;
                                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onDataRange xsd:string
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty <https://w3id.org/ci#quantityUnitOfMeasure> ;
                                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onDataRange xsd:decimal
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty <https://w3id.org/ci#descriptionDetail> ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onDataRange xsd:string
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty <https://w3id.org/ci#techSpecs> ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onDataRange xsd:string
                                               ] ;
                               rdfs:comment "A structured semantic entity representing the action performed within a production result to realize, install, modify, remove, or otherwise act upon a physical Work. An Activity can be characterized through standardized terminology and can be decomposed into the labour, equipment, and temporary components or resources required to perform it."@en ;
                               rdfs:comment "Un'entità semantica strutturata che rappresenta l'azione eseguita all'interno di un risultato produttivo per realizzare, installare, modificare, rimuovere o comunque intervenire su un Work fisico. Un'Activity può essere caratterizzata mediante terminologia standardizzata e può essere scomposta nelle componenti o risorse di manodopera, attrezzature e opere temporanee necessarie alla sua esecuzione."@it ;
                               rdfs:label "Activity" .


###  https://w3id.org/ci#ConstructionComponent
<https://w3id.org/ci#ConstructionComponent> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://w3id.org/ci#CostComponent> ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <https://w3id.org/ci#hasWork> ;
                                                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                              owl:onClass <https://w3id.org/ci#WorkOfConstructionComponent>
                                                            ] ;
                                            owl:disjointWith <https://w3id.org/ci#ProductComponent> ,
                                                             <https://w3id.org/ci#TemporaryComponent> ;
                                            rdfs:comment "A CostComponent representing a completed construction work. It combines an Activity with a WorkOfConstructionComponent to describe, in a structured form, the action performed and the physical part involved in the construction result."@en ;
                                            rdfs:comment "Un CostComponent che rappresenta un'opera compiuta. Combina un'Activity con un WorkOfConstructionComponent per descrivere, in forma strutturata, l'azione eseguita e la parte fisica coinvolta nel risultato costruttivo."@it ;
                                            rdfs:label "Construction Work" .


###  https://w3id.org/ci#CostComponent
<https://w3id.org/ci#CostComponent> rdf:type owl:Class ;
                                    rdfs:subClassOf owl:Thing ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <https://w3id.org/ci#partOf> ;
                                                      owl:allValuesFrom <https://w3id.org/ci#CostItem>
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <https://w3id.org/cterm#hasClassification> ;
                                                      owl:allValuesFrom <https://w3id.org/cterm#Classification>
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <https://w3id.org/cterm#hasCategory> ;
                                                      owl:allValuesFrom <https://w3id.org/cterm#CategoryOfCostComponent>
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <https://w3id.org/cterm#hasFamily> ;
                                                      owl:allValuesFrom <https://w3id.org/cterm#FamilyOfCostComponent>
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <https://w3id.org/cterm#hasMaterial> ;
                                                      owl:allValuesFrom <https://w3id.org/cterm#Material>
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <https://w3id.org/cterm#hasObject> ;
                                                      owl:allValuesFrom <https://w3id.org/cterm#ObjectOfCostComponent>
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <https://w3id.org/ci#hasActivity> ;
                                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                      owl:onClass <https://w3id.org/ci#Activity>
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <https://w3id.org/ci#hasUnit> ;
                                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                      owl:onClass <http://qudt.org/schema/qudt/Unit>
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <https://w3id.org/ci#code> ;
                                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                      owl:onDataRange xsd:string
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <https://w3id.org/ci#descriptionGeneral> ;
                                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                      owl:onDataRange xsd:string
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <https://w3id.org/ci#quantityUnitOfMeasure> ;
                                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                      owl:onDataRange xsd:decimal
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <https://w3id.org/ci#descriptionDetail> ;
                                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                      owl:onDataRange xsd:string
                                                    ] ;
                                    rdfs:comment "A structured semantic information component used to describe a CostItem through standardized descriptive, technical, dimensional, performance, classification, and other domain-specific attributes. A CostComponent represents an informational structure rather than a priced item and does not carry a unit price."@en ;
                                    rdfs:comment "Una componente informativa semantica strutturata utilizzata per descrivere un CostItem mediante attributi standardizzati descrittivi, tecnici, dimensionali, prestazionali, di classificazione e altri attributi specifici del dominio. Un CostComponent rappresenta una struttura informativa e non una voce prezzata e non contiene un prezzo unitario."@it ;
                                    rdfs:label "CostComponent" .


###  https://w3id.org/ci#CostItem
<https://w3id.org/ci#CostItem> rdf:type owl:Class ;
                               owl:equivalentClass <https://w3id.org/ci#ProductionResult> ;
                               rdfs:subClassOf owl:Thing ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty <https://w3id.org/ci#hasPart> ;
                                                 owl:someValuesFrom <https://w3id.org/ci#CostComponent>
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty <https://w3id.org/cterm#hasClassification> ;
                                                 owl:allValuesFrom <https://w3id.org/cterm#Classification>
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty <https://w3id.org/ci#hasUnit> ;
                                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass <http://qudt.org/schema/qudt/Unit>
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty <https://w3id.org/ci#code> ;
                                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onDataRange xsd:string
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty <https://w3id.org/ci#descriptionDetail> ;
                                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onDataRange xsd:string
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty <https://w3id.org/ci#descriptionGeneral> ;
                                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onDataRange xsd:string
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty <https://w3id.org/ci#prefix> ;
                                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onDataRange xsd:string
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty <https://w3id.org/ci#quantityUnitOfMeasure> ;
                                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onDataRange xsd:decimal
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty <https://w3id.org/ci#unitPrice> ;
                                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onDataRange xsd:decimal
                                               ] ;
                               rdfs:comment "A priced production result represented as an item in a construction cost catalogue or price list. It contains identifying, descriptive, quantitative, and economic information, including its unit price, and is semantically described through one or more CostComponents."@en ;
                               rdfs:comment "Un risultato produttivo prezzato rappresentato come voce in un catalogo dei costi o prezzario delle costruzioni. Contiene informazioni identificative, descrittive, quantitative ed economiche, incluso il prezzo unitario, ed è descritto semanticamente mediante uno o più CostComponent."@it ;
                               rdfs:label "CostItem" .


###  https://w3id.org/ci#ProductComponent
<https://w3id.org/ci#ProductComponent> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/ci#CostComponent> ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <https://w3id.org/ci#hasWork> ;
                                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                         owl:onClass <https://w3id.org/ci#WorkOfProductComponent>
                                                       ] ;
                                       owl:disjointWith <https://w3id.org/ci#TemporaryComponent> ;
                                       rdfs:comment "A CostComponent representing a product incorporated into or obtained through a production process. It combines an Activity with a WorkOfProductComponent to describe, in a structured form, the action performed and the physical product involved."@en ;
                                       rdfs:comment "Un CostComponent che rappresenta un prodotto incorporato in, o ottenuto attraverso, un processo produttivo. Combina un'Activity con un WorkOfProductComponent per descrivere, in forma strutturata, l'azione eseguita e il prodotto fisico coinvolto."@it ;
                                       rdfs:label "Product Work" .


###  https://w3id.org/ci#ProductionResult
<https://w3id.org/ci#ProductionResult> rdf:type owl:Class ;
                                       rdfs:subClassOf owl:Thing ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <https://w3id.org/ci#hasPart> ;
                                                         owl:someValuesFrom <https://w3id.org/ci#CostComponent>
                                                       ] ;
                                       rdfs:comment "A result of a construction production process represented as a priced item in a construction cost catalogue or price list. In the CI ontology, a ProductionResult is equivalent to a CostItem and is described through one or more CostComponents."@en ;
                                       rdfs:comment "Un risultato di un processo produttivo delle costruzioni rappresentato come voce prezzata in un catalogo dei costi o prezzario. Nell'ontologia CI, un ProductionResult è equivalente a un CostItem ed è descritto mediante uno o più CostComponent."@it ;
                                       rdfs:label "ProductionResult" .


###  https://w3id.org/ci#TemporaryComponent
<https://w3id.org/ci#TemporaryComponent> rdf:type owl:Class ;
                                         rdfs:subClassOf <https://w3id.org/ci#CostComponent> ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <https://w3id.org/ci#hasWork> ;
                                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                           owl:onClass <https://w3id.org/ci#WorkOfTemporaryComponent>
                                                         ] ;
                                         rdfs:comment "A CostComponent representing a temporary or auxiliary work required to support the execution of construction activities. It combines an Activity with a WorkOfTemporaryComponent to describe, in a structured form, the action performed and the temporary physical work involved."@en ;
                                         rdfs:comment "Un CostComponent che rappresenta un'opera temporanea o ausiliaria necessaria a supportare l'esecuzione delle attività di costruzione. Combina un'Activity con un WorkOfTemporaryComponent per descrivere, in forma strutturata, l'azione eseguita e l'opera fisica temporanea coinvolta."@it ;
                                         rdfs:label "Temporary Work" .


###  https://w3id.org/ci#Work
<https://w3id.org/ci#Work> rdf:type owl:Class ;
                           rdfs:subClassOf owl:Thing ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty <https://w3id.org/cterm#hasDimensionParameter> ;
                                             owl:allValuesFrom <https://w3id.org/cterm#DimensionParameter>
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty <https://w3id.org/cterm#hasOtherStandard> ;
                                             owl:allValuesFrom <https://w3id.org/cterm#Standard>
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty <https://w3id.org/cterm#hasPerformanceParameter> ;
                                             owl:allValuesFrom <https://w3id.org/cterm#PerformanceParameter>
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty <https://w3id.org/cterm#hasPhysicalParameter> ;
                                             owl:allValuesFrom <https://w3id.org/cterm#PhysicalParameter>
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty <https://w3id.org/cterm#hasFamily> ;
                                             owl:allValuesFrom <https://w3id.org/cterm#FamilyOfWork>
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty <https://w3id.org/cterm#hasMaterial> ;
                                             owl:allValuesFrom <https://w3id.org/cterm#Material>
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty <https://w3id.org/ci#hasUnit> ;
                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass <http://qudt.org/schema/qudt/Unit>
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty <https://w3id.org/ci#law> ;
                                             owl:allValuesFrom xsd:string
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty <https://w3id.org/ci#code> ;
                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty <https://w3id.org/ci#descriptionGeneral> ;
                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty <https://w3id.org/ci#quantityUnitOfMeasure> ;
                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:decimal
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty <https://w3id.org/ci#cam> ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:boolean
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty <https://w3id.org/ci#descriptionDetail> ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty <https://w3id.org/ci#techSpecs> ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ;
                           rdfs:comment "A structured semantic entity representing the physical part involved in a production result, as distinct from the Activity performed on or for it. A Work is described through object, material, dimensional, physical, performance, regulatory, and other technical characteristics."@en ;
                           rdfs:comment "Un'entità semantica strutturata che rappresenta la parte fisica coinvolta in un risultato produttivo, distinta dall'Activity eseguita su di essa o per essa. Un Work è descritto mediante caratteristiche relative a oggetto, materiale, dimensioni, proprietà fisiche, prestazioni, requisiti normativi e altri aspetti tecnici."@it ;
                           rdfs:label "Work" .


###  https://w3id.org/ci#WorkOfConstructionComponent
<https://w3id.org/ci#WorkOfConstructionComponent> rdf:type owl:Class ;
                                                  rdfs:subClassOf <https://w3id.org/ci#Work> ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <https://w3id.org/cterm#hasAspect> ;
                                                                    owl:allValuesFrom <https://w3id.org/cterm#AspectOfWorkOfConstructionComponent>
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <https://w3id.org/cterm#hasFinishing> ;
                                                                    owl:allValuesFrom <https://w3id.org/cterm#FinishingOfWorkOfConstructionComponent>
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <https://w3id.org/cterm#hasFunction> ;
                                                                    owl:allValuesFrom <https://w3id.org/cterm#FunctionOfWorkOfConstructionComponent>
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <https://w3id.org/cterm#hasUse> ;
                                                                    owl:allValuesFrom <https://w3id.org/cterm#UseOfWorkOfConstructionComponent>
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <https://w3id.org/cterm#hasCategory> ;
                                                                    owl:allValuesFrom <https://w3id.org/cterm#CategoryOfWorkOfConstructionComponent>
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <https://w3id.org/cterm#hasObject> ;
                                                                    owl:allValuesFrom <https://w3id.org/cterm#ObjectOfWorkOfConstructionComponent>
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <https://w3id.org/cterm#hasType> ;
                                                                    owl:allValuesFrom <https://w3id.org/cterm#TypeOfWorkOfConstructionComponent>
                                                                  ] ;
                                                  owl:disjointWith <https://w3id.org/ci#WorkOfProductComponent> ,
                                                                   <https://w3id.org/ci#WorkOfTemporaryComponent> ;
                                                  rdfs:comment "A Work specialization representing the physical part of a ConstructionComponent. It describes the construction object and its technical characteristics and may be decomposed into construction components, product components, and material resources."@en ;
                                                  rdfs:comment "Una specializzazione di Work che rappresenta la parte fisica di un ConstructionComponent. Descrive l'oggetto costruito e le relative caratteristiche tecniche e può essere scomposta in ConstructionComponent, ProductComponent e MaterialResource."@it ;
                                                  rdfs:label "WorkOfConstructionComponent" .


###  https://w3id.org/ci#WorkOfProductComponent
<https://w3id.org/ci#WorkOfProductComponent> rdf:type owl:Class ;
                                             rdfs:subClassOf <https://w3id.org/ci#Work> ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <https://w3id.org/cterm#hasAspect> ;
                                                               owl:allValuesFrom <https://w3id.org/cterm#AspectOfWorkOfProductComponent>
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <https://w3id.org/cterm#hasFinishing> ;
                                                               owl:allValuesFrom <https://w3id.org/cterm#FinishingOfWorkOfProductComponent>
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <https://w3id.org/cterm#hasFunction> ;
                                                               owl:allValuesFrom <https://w3id.org/cterm#FunctionOfWorkOfProductComponent>
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <https://w3id.org/cterm#hasUse> ;
                                                               owl:allValuesFrom <https://w3id.org/cterm#UseOfWorkOfProductComponent>
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <https://w3id.org/cterm#hasCategory> ;
                                                               owl:allValuesFrom <https://w3id.org/cterm#CategoryOfWorkOfProductComponent>
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <https://w3id.org/cterm#hasObject> ;
                                                               owl:allValuesFrom <https://w3id.org/cterm#ObjectOfWorkOfProductComponent>
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <https://w3id.org/cterm#hasType> ;
                                                               owl:allValuesFrom <https://w3id.org/cterm#TypeOfWorkOfProductComponent>
                                                             ] ;
                                             owl:disjointWith <https://w3id.org/ci#WorkOfTemporaryComponent> ;
                                             rdfs:comment "A Work specialization representing the physical part of a ProductComponent. It describes the product and its technical characteristics and may be decomposed into the material resources from which the product is formed."@en ;
                                             rdfs:comment "Una specializzazione di Work che rappresenta la parte fisica di un ProductComponent. Descrive il prodotto e le relative caratteristiche tecniche e può essere scomposta nelle MaterialResource da cui il prodotto è costituito."@it ;
                                             rdfs:label "WorkOfProductComponent" .


###  https://w3id.org/ci#WorkOfTemporaryComponent
<https://w3id.org/ci#WorkOfTemporaryComponent> rdf:type owl:Class ;
                                               rdfs:subClassOf <https://w3id.org/ci#Work> ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <https://w3id.org/cterm#hasAspect> ;
                                                                 owl:allValuesFrom <https://w3id.org/cterm#AspectOfWorkOfTemporaryComponent>
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <https://w3id.org/cterm#hasFinishing> ;
                                                                 owl:allValuesFrom <https://w3id.org/cterm#FinishingOfWorkOfTemporaryComponent>
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <https://w3id.org/cterm#hasFunction> ;
                                                                 owl:allValuesFrom <https://w3id.org/cterm#FunctionOfWorkOfTemporaryComponent>
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <https://w3id.org/cterm#hasUse> ;
                                                                 owl:allValuesFrom <https://w3id.org/cterm#UseOfWorkOfTemporaryComponent>
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <https://w3id.org/cterm#hasCategory> ;
                                                                 owl:allValuesFrom <https://w3id.org/cterm#CategoryOfWorkOfTemporaryComponent>
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <https://w3id.org/cterm#hasObject> ;
                                                                 owl:allValuesFrom <https://w3id.org/cterm#ObjectOfWorkOfTemporaryComponent>
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <https://w3id.org/cterm#hasType> ;
                                                                 owl:allValuesFrom <https://w3id.org/cterm#TypeOfWorkOfTemporaryComponent>
                                                               ] ;
                                               rdfs:comment "A Work specialization representing the physical part of a TemporaryComponent. It describes the temporary or auxiliary work and its technical characteristics and may be decomposed into product components, equipment resources, and material resources."@en ;
                                               rdfs:comment "Una specializzazione di Work che rappresenta la parte fisica di un TemporaryComponent. Descrive l'opera temporanea o ausiliaria e le relative caratteristiche tecniche e può essere scomposta in ProductComponent, EquipmentResource e MaterialResource."@it ;
                                               rdfs:label "WorkOfTemporaryComponent" .


