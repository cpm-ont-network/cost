#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/ci#activityOf
<https://w3id.org/ci#activityOf> rdf:type owl:ObjectProperty ;
                                 owl:inverseOf <https://w3id.org/ci#hasActivity> ;
                                 rdfs:domain <https://w3id.org/ci#Activity> ;
                                 rdfs:range <https://w3id.org/ci#CostComponent> ;
                                 rdfs:comment "Relates an Activity to the CostComponent for which the activity provides the operational description."@en ;
                                 rdfs:comment "Mette in relazione un'Activity con il CostComponent per il quale l'attività fornisce la descrizione operativa."@it ;
                                 rdfs:label "activity of" .


###  https://w3id.org/ci#hasActivity
<https://w3id.org/ci#hasActivity> rdf:type owl:ObjectProperty ;
                                  rdfs:domain <https://w3id.org/ci#CostComponent> ;
                                  rdfs:range <https://w3id.org/ci#Activity> ;
                                  rdfs:comment "Relates a CostComponent to the Activity that describes the action performed as part of that component."@en ;
                                  rdfs:comment "Mette in relazione un CostComponent con l'Activity che descrive l'azione eseguita come parte di tale componente."@it ;
                                  rdfs:label "hasActivity" .


###  https://w3id.org/ci#hasPart
<https://w3id.org/ci#hasPart> rdf:type owl:ObjectProperty ;
                              rdfs:domain [ rdf:type owl:Class ;
                                            owl:unionOf ( <https://w3id.org/ci#CostItem>
                                                          <https://w3id.org/ci#ProductionResult>
                                                        )
                                          ] ;
                              rdfs:range <https://w3id.org/ci#CostComponent> ;
                              rdfs:comment "Relates a CostItem or ProductionResult to a CostComponent that forms part of its structured semantic description."@en ;
                              rdfs:comment "Mette in relazione un CostItem o ProductionResult con un CostComponent che costituisce parte della sua descrizione semantica strutturata."@it ;
                              rdfs:label "hasPart" .


###  https://w3id.org/ci#hasSubComponent
<https://w3id.org/ci#hasSubComponent> rdf:type owl:ObjectProperty ;
                                      rdfs:domain [ rdf:type owl:Class ;
                                                    owl:unionOf ( <https://w3id.org/ci#Activity>
                                                                  <https://w3id.org/ci#CostComponent>
                                                                  <https://w3id.org/ci#Work>
                                                                )
                                                  ] ;
                                      rdfs:range [ rdf:type owl:Class ;
                                                   owl:unionOf ( <https://w3id.org/ci#CostComponent>
                                                                 <https://w3id.org/cr#Resource>
                                                               )
                                                 ] ;
                                      rdfs:comment "Relates an Activity, Work, or CostComponent to a constituent CostComponent or construction Resource used to represent its internal composition."@en ;
                                      rdfs:comment "Mette in relazione un'Activity, un Work o un CostComponent con un CostComponent costituente o una Resource delle costruzioni utilizzata per rappresentarne la composizione interna."@it ;
                                      rdfs:label "hasSubComponent" .


###  https://w3id.org/ci#hasUnit
<https://w3id.org/ci#hasUnit> rdf:type owl:ObjectProperty ;
                              rdfs:domain [ rdf:type owl:Class ;
                                            owl:unionOf ( <https://w3id.org/ci#Activity>
                                                          <https://w3id.org/ci#CostComponent>
                                                          <https://w3id.org/ci#CostItem>
                                                          <https://w3id.org/ci#Work>
                                                        )
                                          ] ;
                              rdfs:range <http://qudt.org/schema/qudt/Unit> ;
                              rdfs:comment "Relates an entity in the CI ontology to the QUDT unit used to express its associated quantity."@en ;
                              rdfs:comment "Mette in relazione un'entità dell'ontologia CI con l'unità QUDT utilizzata per esprimere la quantità associata."@it ;
                              rdfs:label "hasUnit" .


###  https://w3id.org/ci#hasWork
<https://w3id.org/ci#hasWork> rdf:type owl:ObjectProperty ;
                              owl:inverseOf <https://w3id.org/ci#workOf> ;
                              rdfs:domain <https://w3id.org/ci#CostComponent> ;
                              rdfs:range <https://w3id.org/ci#Work> ;
                              rdfs:comment "Relates a CostComponent to the Work that describes its physical part."@en ;
                              rdfs:comment "Mette in relazione un CostComponent con il Work che ne descrive la parte fisica."@it ;
                              rdfs:label "hasWork" .


###  https://w3id.org/ci#partOf
<https://w3id.org/ci#partOf> rdf:type owl:ObjectProperty ;
                             owl:inverseOf <https://w3id.org/ci#hasPart> ;
                             rdfs:domain <https://w3id.org/ci#CostComponent> ;
                             rdfs:range [ rdf:type owl:Class ;
                                          owl:unionOf ( <https://w3id.org/ci#CostItem>
                                                        <https://w3id.org/ci#ProductionResult>
                                                      )
                                        ] ;
                             rdfs:comment "Relates a CostComponent to the CostItem or ProductionResult of whose structured semantic description it forms a part."@en ;
                             rdfs:comment "Mette in relazione un CostComponent con il CostItem o ProductionResult della cui descrizione semantica strutturata costituisce una parte."@it ;
                             rdfs:label "partOf" .


###  https://w3id.org/ci#subComponentOf
<https://w3id.org/ci#subComponentOf> rdf:type owl:ObjectProperty ;
                                     owl:inverseOf <https://w3id.org/ci#hasSubComponent> ;
                                     rdfs:domain [ rdf:type owl:Class ;
                                                   owl:unionOf ( <https://w3id.org/ci#CostComponent>
                                                                 <https://w3id.org/cr#Resource>
                                                               )
                                                 ] ;
                                     rdfs:range [ rdf:type owl:Class ;
                                                  owl:unionOf ( <https://w3id.org/ci#Activity>
                                                                <https://w3id.org/ci#CostComponent>
                                                                <https://w3id.org/ci#Work>
                                                              )
                                                ] ;
                                     rdfs:comment "Relates a CostComponent or construction Resource to the Activity, Work, or CostComponent of which it is a constituent subcomponent."@en ;
                                     rdfs:comment "Mette in relazione un CostComponent o una Resource delle costruzioni con l'Activity, il Work o il CostComponent di cui costituisce un sottocomponente."@it ;
                                     rdfs:label "subComponentOf" .


###  https://w3id.org/ci#unitOf
<https://w3id.org/ci#unitOf> rdf:type owl:ObjectProperty ;
                             owl:inverseOf <https://w3id.org/ci#hasUnit> ;
                             rdfs:domain <http://qudt.org/schema/qudt/Unit> ;
                             rdfs:range [ rdf:type owl:Class ;
                                          owl:unionOf ( <https://w3id.org/ci#Activity>
                                                        <https://w3id.org/ci#CostComponent>
                                                        <https://w3id.org/ci#CostItem>
                                                        <https://w3id.org/ci#Work>
                                                      )
                                        ] ;
                             rdfs:comment "Relates a QUDT unit to an entity in the CI ontology whose associated quantity is expressed using that unit."@en ;
                             rdfs:comment "Mette in relazione un'unità QUDT con un'entità dell'ontologia CI la cui quantità associata è espressa mediante tale unità."@it ;
                             rdfs:label "unitOf" .


###  https://w3id.org/ci#workOf
<https://w3id.org/ci#workOf> rdf:type owl:ObjectProperty ;
                             rdfs:domain <https://w3id.org/ci#Work> ;
                             rdfs:range <https://w3id.org/ci#CostComponent> ;
                             rdfs:comment "Relates a Work to the CostComponent whose physical part it describes."@en ;
                             rdfs:comment "Mette in relazione un Work con il CostComponent di cui descrive la parte fisica."@it ;
                             rdfs:label "workOf" .


###  https://w3id.org/cterm#hasAspect
<https://w3id.org/cterm#hasAspect> rdf:type owl:ObjectProperty .


###  https://w3id.org/cterm#hasCategory
<https://w3id.org/cterm#hasCategory> rdf:type owl:ObjectProperty .


###  https://w3id.org/cterm#hasClassification
