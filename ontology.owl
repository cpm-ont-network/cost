    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/ci#activityOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ci#activityOf">
        <owl:inverseOf rdf:resource="https://w3id.org/ci#hasActivity"/>
        <rdfs:domain rdf:resource="https://w3id.org/ci#Activity"/>
        <rdfs:range rdf:resource="https://w3id.org/ci#CostComponent"/>
        <rdfs:comment xml:lang="it">Mette in relazione un&apos;Activity con il CostComponent per il quale l&apos;attività fornisce la descrizione operativa.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates an Activity to the CostComponent for which the activity provides the operational description.</rdfs:comment>
        <rdfs:label>activity of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ci#hasActivity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ci#hasActivity">
        <rdfs:domain rdf:resource="https://w3id.org/ci#CostComponent"/>
        <rdfs:range rdf:resource="https://w3id.org/ci#Activity"/>
        <rdfs:comment xml:lang="it">Mette in relazione un CostComponent con l&apos;Activity che descrive l&apos;azione eseguita come parte di tale componente.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a CostComponent to the Activity that describes the action performed as part of that component.</rdfs:comment>
        <rdfs:label>hasActivity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ci#hasPart -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ci#hasPart">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ci#CostItem"/>
                    <rdf:Description rdf:about="https://w3id.org/ci#ProductionResult"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/ci#CostComponent"/>
        <rdfs:comment xml:lang="it">Mette in relazione un CostItem o ProductionResult con un CostComponent che costituisce parte della sua descrizione semantica strutturata.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a CostItem or ProductionResult to a CostComponent that forms part of its structured semantic description.</rdfs:comment>
        <rdfs:label>hasPart</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ci#hasSubComponent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ci#hasSubComponent">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ci#Activity"/>
                    <rdf:Description rdf:about="https://w3id.org/ci#CostComponent"/>
                    <rdf:Description rdf:about="https://w3id.org/ci#Work"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ci#CostComponent"/>
                    <rdf:Description rdf:about="https://w3id.org/cr#Resource"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="it">Mette in relazione un&apos;Activity, un Work o un CostComponent con un CostComponent costituente o una Resource delle costruzioni utilizzata per rappresentarne la composizione interna.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates an Activity, Work, or CostComponent to a constituent CostComponent or construction Resource used to represent its internal composition.</rdfs:comment>
        <rdfs:label>hasSubComponent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ci#hasUnit -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ci#hasUnit">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ci#Activity"/>
                    <rdf:Description rdf:about="https://w3id.org/ci#CostComponent"/>
                    <rdf:Description rdf:about="https://w3id.org/ci#CostItem"/>
                    <rdf:Description rdf:about="https://w3id.org/ci#Work"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <rdfs:comment xml:lang="it">Mette in relazione un&apos;entità dell&apos;ontologia CI con l&apos;unità QUDT utilizzata per esprimere la quantità associata.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates an entity in the CI ontology to the QUDT unit used to express its associated quantity.</rdfs:comment>
        <rdfs:label>hasUnit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ci#hasWork -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ci#hasWork">
        <owl:inverseOf rdf:resource="https://w3id.org/ci#workOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/ci#CostComponent"/>
        <rdfs:range rdf:resource="https://w3id.org/ci#Work"/>
        <rdfs:comment xml:lang="it">Mette in relazione un CostComponent con il Work che ne descrive la parte fisica.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a CostComponent to the Work that describes its physical part.</rdfs:comment>
        <rdfs:label>hasWork</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ci#partOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ci#partOf">
        <owl:inverseOf rdf:resource="https://w3id.org/ci#hasPart"/>
        <rdfs:domain rdf:resource="https://w3id.org/ci#CostComponent"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ci#CostItem"/>
                    <rdf:Description rdf:about="https://w3id.org/ci#ProductionResult"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="it">Mette in relazione un CostComponent con il CostItem o ProductionResult della cui descrizione semantica strutturata costituisce una parte.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a CostComponent to the CostItem or ProductionResult of whose structured semantic description it forms a part.</rdfs:comment>
        <rdfs:label>partOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ci#subComponentOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ci#subComponentOf">
        <owl:inverseOf rdf:resource="https://w3id.org/ci#hasSubComponent"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ci#CostComponent"/>
                    <rdf:Description rdf:about="https://w3id.org/cr#Resource"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ci#Activity"/>
                    <rdf:Description rdf:about="https://w3id.org/ci#CostComponent"/>
                    <rdf:Description rdf:about="https://w3id.org/ci#Work"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="it">Mette in relazione un CostComponent o una Resource delle costruzioni con l&apos;Activity, il Work o il CostComponent di cui costituisce un sottocomponente.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a CostComponent or construction Resource to the Activity, Work, or CostComponent of which it is a constituent subcomponent.</rdfs:comment>
        <rdfs:label>subComponentOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ci#unitOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ci#unitOf">
        <owl:inverseOf rdf:resource="https://w3id.org/ci#hasUnit"/>
        <rdfs:domain rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ci#Activity"/>
                    <rdf:Description rdf:about="https://w3id.org/ci#CostComponent"/>
                    <rdf:Description rdf:about="https://w3id.org/ci#CostItem"/>
                    <rdf:Description rdf:about="https://w3id.org/ci#Work"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="it">Mette in relazione un&apos;unità QUDT con un&apos;entità dell&apos;ontologia CI la cui quantità associata è espressa mediante tale unità.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a QUDT unit to an entity in the CI ontology whose associated quantity is expressed using that unit.</rdfs:comment>
        <rdfs:label>unitOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ci#workOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ci#workOf">
        <rdfs:domain rdf:resource="https://w3id.org/ci#Work"/>
        <rdfs:range rdf:resource="https://w3id.org/ci#CostComponent"/>
        <rdfs:comment xml:lang="it">Mette in relazione un Work con il CostComponent di cui descrive la parte fisica.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a Work to the CostComponent whose physical part it describes.</rdfs:comment>
        <rdfs:label>workOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cterm#hasAspect -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cterm#hasAspect"/>
    


    <!-- https://w3id.org/cterm#hasCategory -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cterm#hasCategory"/>
    


