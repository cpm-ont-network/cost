                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#FunctionOfWorkOfConstructionComponent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasObject"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#ObjectOfWorkOfConstructionComponent"/>
