    <owl:ObjectProperty rdf:about="https://w3id.org/cterm#hasUse"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/ci#cam -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ci#cam">
        <rdfs:domain rdf:resource="https://w3id.org/ci#Work"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="it">Indica se un Work è associato ai Criteri Ambientali Minimi (CAM) definiti dal Ministero italiano dell&apos;Ambiente.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates whether a Work is associated with the Minimum Environmental Criteria (Criteri Ambientali Minimi, CAM) defined by the Italian Ministry of Environment.</rdfs:comment>
        <rdfs:label>environmental and ecological requirements defined by the Italian Ministry of Environment</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ci#code -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ci#code">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ci#Activity"/>
                    <rdf:Description rdf:about="https://w3id.org/ci#CostComponent"/>
                    <rdf:Description rdf:about="https://w3id.org/ci#CostItem"/>
                    <rdf:Description rdf:about="https://w3id.org/ci#Work"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="it">Fornisce l&apos;identificatore alfanumerico o il codice di classificazione assegnato a un&apos;Activity, CostComponent, CostItem o Work.</rdfs:comment>
        <rdfs:comment xml:lang="en">Provides the alphanumeric identifier or classification code assigned to an Activity, CostComponent, CostItem, or Work.</rdfs:comment>
        <rdfs:label>code</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ci#descriptionDetail -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ci#descriptionDetail">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ci#Activity"/>
                    <rdf:Description rdf:about="https://w3id.org/ci#CostComponent"/>
                    <rdf:Description rdf:about="https://w3id.org/ci#CostItem"/>
                    <rdf:Description rdf:about="https://w3id.org/ci#Work"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="it">Fornisce una descrizione testuale di dettaglio che integra la descrizione generale dell&apos;entità rappresentata.</rdfs:comment>
        <rdfs:comment xml:lang="en">Provides a detailed textual description that complements the general description of the represented entity.</rdfs:comment>
        <rdfs:label>descriptionDetail</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ci#descriptionGeneral -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ci#descriptionGeneral">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ci#Activity"/>
                    <rdf:Description rdf:about="https://w3id.org/ci#CostComponent"/>
                    <rdf:Description rdf:about="https://w3id.org/ci#CostItem"/>
                    <rdf:Description rdf:about="https://w3id.org/ci#Work"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="it">Fornisce la descrizione testuale generale utilizzata per identificare e descrivere l&apos;entità rappresentata in forma standardizzata.</rdfs:comment>
        <rdfs:comment xml:lang="en">Provides the general textual description used to identify and describe the represented entity in a standardized form.</rdfs:comment>
        <rdfs:label>descriptionGeneral</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ci#excluded -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ci#excluded">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ci#Activity"/>
                    <rdf:Description rdf:about="https://w3id.org/ci#Work"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="it">Specifica, in forma testuale, voci, operazioni, condizioni o prescrizioni esplicitamente escluse dall&apos;ambito di un&apos;Activity o di un Work.</rdfs:comment>
        <rdfs:comment xml:lang="en">Specifies, in textual form, items, operations, conditions, or provisions that are explicitly excluded from the scope of an Activity or Work.</rdfs:comment>
        <rdfs:label>excluded</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ci#included -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ci#included">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ci#Activity"/>
                    <rdf:Description rdf:about="https://w3id.org/ci#Work"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="it">Specifica, in forma testuale, voci, operazioni, condizioni o prescrizioni esplicitamente incluse nell&apos;ambito di un&apos;Activity o di un Work.</rdfs:comment>
        <rdfs:comment xml:lang="en">Specifies, in textual form, items, operations, conditions, or provisions that are explicitly included within the scope of an Activity or Work.</rdfs:comment>
        <rdfs:label>included</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ci#keywords -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ci#keywords">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ci#Activity"/>
                    <rdf:Description rdf:about="https://w3id.org/ci#Work"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="it">Fornisce parole chiave utilizzate per supportare l&apos;identificazione, l&apos;indicizzazione, il recupero o l&apos;interpretazione di un&apos;Activity o di un Work.</rdfs:comment>
        <rdfs:comment xml:lang="en">Provides keywords used to support the identification, indexing, retrieval, or interpretation of an Activity or Work.</rdfs:comment>
        <rdfs:label>keywords</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ci#law -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ci#law">
        <rdfs:domain rdf:resource="https://w3id.org/ci#Work"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="it">Fornisce un riferimento testuale alla legislazione o ai requisiti normativi applicabili a un Work.</rdfs:comment>
        <rdfs:comment xml:lang="en">Provides a textual reference to legislation or regulatory requirements applicable to a Work.</rdfs:comment>
        <rdfs:label>law</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ci#measurementRules -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ci#measurementRules">
        <rdfs:domain rdf:resource="https://w3id.org/ci#CostComponent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="it">Specifica le regole o i criteri da applicare nella misurazione o quantificazione di un CostComponent.</rdfs:comment>
        <rdfs:comment xml:lang="en">Specifies the rules or criteria to be applied when measuring or quantifying a CostComponent.</rdfs:comment>
        <rdfs:label>measurementRules</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ci#prefix -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ci#prefix">
        <rdfs:domain rdf:resource="https://w3id.org/ci#CostItem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="it">Fornisce il prefisso utilizzato come segmento identificativo del codice assegnato a un CostItem.</rdfs:comment>
        <rdfs:comment xml:lang="en">Provides the prefix used as an identifying segment of the code assigned to a CostItem.</rdfs:comment>
        <rdfs:label xml:lang="it">prefisso</rdfs:label>
        <rdfs:label xml:lang="en">prefix</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ci#quantityUnitOfMeasure -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ci#quantityUnitOfMeasure">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ci#Activity"/>
                    <rdf:Description rdf:about="https://w3id.org/ci#CostComponent"/>
                    <rdf:Description rdf:about="https://w3id.org/ci#CostItem"/>
                    <rdf:Description rdf:about="https://w3id.org/ci#Work"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="it">Specifica la quantità numerica associata all&apos;unità di misura di riferimento utilizzata per esprimere l&apos;entità rappresentata, ad esempio 1 metro quadrato o 100 unità.</rdfs:comment>
        <rdfs:comment xml:lang="en">Specifies the numerical quantity associated with the reference unit of measure used to express the represented entity, for example 1 square metre or 100 units.</rdfs:comment>
        <rdfs:label>quantityUnitOfMeasure</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ci#techSpecs -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ci#techSpecs">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ci#Activity"/>
                    <rdf:Description rdf:about="https://w3id.org/ci#Work"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="it">Fornisce specifiche tecniche, requisiti o condizioni di esecuzione associati a un&apos;Activity o a un Work.</rdfs:comment>
        <rdfs:comment xml:lang="en">Provides technical specifications, requirements, or execution conditions associated with an Activity or Work.</rdfs:comment>
        <rdfs:label>tech specs</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ci#unitPrice -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ci#unitPrice">
        <rdfs:domain rdf:resource="https://w3id.org/ci#CostItem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="it">Specifica il prezzo unitario monetario assegnato a un CostItem o ProductionResult per la relativa unità di misura di riferimento.</rdfs:comment>
        <rdfs:comment xml:lang="en">Specifies the monetary unit price assigned to a CostItem or ProductionResult for its reference unit of measure.</rdfs:comment>
        <rdfs:label>unit price</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://qudt.org/schema/qudt/Unit -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/Unit"/>
    


    <!-- https://schema.org/Person -->


    <owl:Class rdf:about="https://schema.org/Person"/>
    


    <!-- https://w3id.org/ci#Activity -->


    <owl:Class rdf:about="https://w3id.org/ci#Activity">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasCategory"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#CategoryOfActivity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasFamily"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#FamilyOfActivity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasFunction"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#FunctionOfActivity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasObject"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#ObjectOfActivity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasType"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#TypeOfActivity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasUse"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#UseOfActivity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ci#hasUnit"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://qudt.org/schema/qudt/Unit"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ci#code"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ci#descriptionGeneral"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ci#quantityUnitOfMeasure"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ci#descriptionDetail"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ci#techSpecs"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A structured semantic entity representing the action performed within a production result to realize, install, modify, remove, or otherwise act upon a physical Work. An Activity can be characterized through standardized terminology and can be decomposed into the labour, equipment, and temporary components or resources required to perform it.</rdfs:comment>
        <rdfs:comment xml:lang="it">Un&apos;entità semantica strutturata che rappresenta l&apos;azione eseguita all&apos;interno di un risultato produttivo per realizzare, installare, modificare, rimuovere o comunque intervenire su un Work fisico. Un&apos;Activity può essere caratterizzata mediante terminologia standardizzata e può essere scomposta nelle componenti o risorse di manodopera, attrezzature e opere temporanee necessarie alla sua esecuzione.</rdfs:comment>
        <rdfs:label>Activity</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ci#ConstructionComponent -->


    <owl:Class rdf:about="https://w3id.org/ci#ConstructionComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ci#CostComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ci#hasWork"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ci#WorkOfConstructionComponent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/ci#ProductComponent"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ci#TemporaryComponent"/>
        <rdfs:comment xml:lang="en">A CostComponent representing a completed construction work. It combines an Activity with a WorkOfConstructionComponent to describe, in a structured form, the action performed and the physical part involved in the construction result.</rdfs:comment>
        <rdfs:comment xml:lang="it">Un CostComponent che rappresenta un&apos;opera compiuta. Combina un&apos;Activity con un WorkOfConstructionComponent per descrivere, in forma strutturata, l&apos;azione eseguita e la parte fisica coinvolta nel risultato costruttivo.</rdfs:comment>
        <rdfs:label>Construction Work</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ci#CostComponent -->


    <owl:Class rdf:about="https://w3id.org/ci#CostComponent">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ci#partOf"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ci#CostItem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasCategory"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#CategoryOfCostComponent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasClassification"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#Classification"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasFamily"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#FamilyOfCostComponent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasMaterial"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#Material"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasObject"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#ObjectOfCostComponent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ci#hasActivity"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ci#Activity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ci#hasUnit"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://qudt.org/schema/qudt/Unit"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ci#code"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ci#descriptionGeneral"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ci#quantityUnitOfMeasure"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ci#descriptionDetail"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A structured semantic information component used to describe a CostItem through standardized descriptive, technical, dimensional, performance, classification, and other domain-specific attributes. A CostComponent represents an informational structure rather than a priced item and does not carry a unit price.</rdfs:comment>
        <rdfs:comment xml:lang="it">Una componente informativa semantica strutturata utilizzata per descrivere un CostItem mediante attributi standardizzati descrittivi, tecnici, dimensionali, prestazionali, di classificazione e altri attributi specifici del dominio. Un CostComponent rappresenta una struttura informativa e non una voce prezzata e non contiene un prezzo unitario.</rdfs:comment>
        <rdfs:label>CostComponent</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ci#CostItem -->


    <owl:Class rdf:about="https://w3id.org/ci#CostItem">
        <owl:equivalentClass rdf:resource="https://w3id.org/ci#ProductionResult"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ci#hasPart"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/ci#CostComponent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasClassification"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#Classification"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ci#hasUnit"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://qudt.org/schema/qudt/Unit"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ci#code"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ci#descriptionDetail"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ci#descriptionGeneral"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ci#prefix"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ci#quantityUnitOfMeasure"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ci#unitPrice"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A priced production result represented as an item in a construction cost catalogue or price list. It contains identifying, descriptive, quantitative, and economic information, including its unit price, and is semantically described through one or more CostComponents.</rdfs:comment>
        <rdfs:comment xml:lang="it">Un risultato produttivo prezzato rappresentato come voce in un catalogo dei costi o prezzario delle costruzioni. Contiene informazioni identificative, descrittive, quantitative ed economiche, incluso il prezzo unitario, ed è descritto semanticamente mediante uno o più CostComponent.</rdfs:comment>
        <rdfs:label>CostItem</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ci#ProductComponent -->


    <owl:Class rdf:about="https://w3id.org/ci#ProductComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ci#CostComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ci#hasWork"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ci#WorkOfProductComponent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/ci#TemporaryComponent"/>
        <rdfs:comment xml:lang="en">A CostComponent representing a product incorporated into or obtained through a production process. It combines an Activity with a WorkOfProductComponent to describe, in a structured form, the action performed and the physical product involved.</rdfs:comment>
        <rdfs:comment xml:lang="it">Un CostComponent che rappresenta un prodotto incorporato in, o ottenuto attraverso, un processo produttivo. Combina un&apos;Activity con un WorkOfProductComponent per descrivere, in forma strutturata, l&apos;azione eseguita e il prodotto fisico coinvolto.</rdfs:comment>
        <rdfs:label>Product Work</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ci#ProductionResult -->


    <owl:Class rdf:about="https://w3id.org/ci#ProductionResult">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ci#hasPart"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/ci#CostComponent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A result of a construction production process represented as a priced item in a construction cost catalogue or price list. In the CI ontology, a ProductionResult is equivalent to a CostItem and is described through one or more CostComponents.</rdfs:comment>
        <rdfs:comment xml:lang="it">Un risultato di un processo produttivo delle costruzioni rappresentato come voce prezzata in un catalogo dei costi o prezzario. Nell&apos;ontologia CI, un ProductionResult è equivalente a un CostItem ed è descritto mediante uno o più CostComponent.</rdfs:comment>
        <rdfs:label>ProductionResult</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ci#TemporaryComponent -->


    <owl:Class rdf:about="https://w3id.org/ci#TemporaryComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ci#CostComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ci#hasWork"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ci#WorkOfTemporaryComponent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A CostComponent representing a temporary or auxiliary work required to support the execution of construction activities. It combines an Activity with a WorkOfTemporaryComponent to describe, in a structured form, the action performed and the temporary physical work involved.</rdfs:comment>
        <rdfs:comment xml:lang="it">Un CostComponent che rappresenta un&apos;opera temporanea o ausiliaria necessaria a supportare l&apos;esecuzione delle attività di costruzione. Combina un&apos;Activity con un WorkOfTemporaryComponent per descrivere, in forma strutturata, l&apos;azione eseguita e l&apos;opera fisica temporanea coinvolta.</rdfs:comment>
        <rdfs:label>Temporary Work</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ci#Work -->


