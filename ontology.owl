<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/ci#"
     xml:base="https://w3id.org/ci"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:schema="https://schema.org/">
    <owl:Ontology rdf:about="https://w3id.org/ci">
        <owl:imports rdf:resource="https://w3id.org/cterm"/>
        <terms:bibliographicCitation></terms:bibliographicCitation>
        <terms:contributor rdf:nodeID="genid1"/>
        <terms:contributor rdf:nodeID="genid3"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-10-12</terms:created>
        <terms:creator rdf:nodeID="genid5"/>
        <terms:creator rdf:nodeID="genid7"/>
        <terms:description xml:lang="it">L&apos;ontologia Cost Item (CI) si basa su concetti e principi della stima dei costi dei progetti di costruzione e può essere utilizzata insieme all&apos;ontologia Construction Resources (CR), utilizzando la terminologia della Construction Terminology (CTERM).</terms:description>
        <terms:description xml:lang="en">The Cost Item (CI) Ontology is based on concepts and principles of construction project cost estimation and can be used together with the Construction Resources (CR) ontology and can use terminology from the Construction Terminology (CTERM).</terms:description>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</terms:modified>
        <terms:rights>Copyright 2025 by DABC, PoliMi</terms:rights>
        <terms:title xml:lang="en">The Cost Item (CI) Ontology</terms:title>
        <vann:preferredNamespacePrefix>ci</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri rdf:resource="https://w3id.org/ci#"/>
        <owl:versionInfo>0.3</owl:versionInfo>
        <schema:codeRepository rdf:resource="https://github.com/cpm-ont-network/cost"/>
    </owl:Ontology>
