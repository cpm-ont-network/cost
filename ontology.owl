    <owl:ObjectProperty rdf:about="https://w3id.org/cterm#hasDimensionParameter"/>
    


    <!-- https://w3id.org/cterm#hasFamily -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cterm#hasFamily"/>
    


    <!-- https://w3id.org/cterm#hasFinishing -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cterm#hasFinishing"/>
    


    <!-- https://w3id.org/cterm#hasFunction -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cterm#hasFunction"/>
    


    <!-- https://w3id.org/cterm#hasMaterial -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cterm#hasMaterial"/>
    


    <!-- https://w3id.org/cterm#hasObject -->


