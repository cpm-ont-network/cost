            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/ci#WorkOfTemporaryComponent"/>
        <rdfs:comment xml:lang="en">A Work specialization representing the physical part of a ProductComponent. It describes the product and its technical characteristics and may be decomposed into the material resources from which the product is formed.</rdfs:comment>
        <rdfs:comment xml:lang="it">Una specializzazione di Work che rappresenta la parte fisica di un ProductComponent. Descrive il prodotto e le relative caratteristiche tecniche e può essere scomposta nelle MaterialResource da cui il prodotto è costituito.</rdfs:comment>
        <rdfs:label>WorkOfProductComponent</rdfs:label>
    </owl:Class>
    


